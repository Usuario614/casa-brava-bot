      "name": "Webhook - Recibe reserva",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1232,
        -256
      ],
      "webhookId": "casa-brava-reserva",
      "notes": "Esta MISMA URL la usan dos cosas: el formulario de la landing (submitBooking) y el bot de WhatsApp (app.py). Ambos mandan el mismo formato de datos, solo cambia el campo 'canal'."
    },
    {
      "parameters": {
        "jsCode": "// Normaliza los datos, sin importar si vinieron del formulario web\n// o del bot de WhatsApp. Los dos mandan (al menos) estos campos:\n//   name, service, date, nights, people, message, phone, lang, canal, code\nconst data = $input.first().json.body || {};\n\nconst nights = parseInt(data.nights || '1', 10) || 1;\nlet startDate = '';\nlet endDate = '';\n\nif (data.date) {\n  const start = new Date(data.date + 'T00:00:00');\n  const end = new Date(start);\n  end.setDate(end.getDate() + nights);\n  const fmt = (d) => d.toISOString().slice(0, 10);\n  startDate = fmt(start);\n  endDate = fmt(end);\n}\n\nconst now = new Date();\n\n// El formulario web (submitBooking) todavía no genera código de\n// reserva, así que si no viene ninguno le armamos uno acá mismo\n// para que TODAS las filas del Sheet tengan uno.\nfunction generarCodigo() {\n  const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\n  let s = '';\n  for (let i = 0; i < 5; i++) s += chars[Math.floor(Math.random() * chars.length)];\n  return 'ARR-' + s;\n}\nconst codigo = data.code || generarCodigo();\n\nreturn [{\n  json: {\n    fechaRegistro: now.toISOString().slice(0, 19).replace('T', ' '),\n    codigoReserva: codigo,\n    nombre: data.name || '',\n    telefono: data.phone || '',\n    servicio: data.service || '',\n    fechaReserva: data.date || '',\n    noches: nights,\n    personas: data.people || '',\n    mensaje: data.message || '',\n    idioma: data.lang || '',\n    canal: data.canal || 'formulario_web',\n    esHospedagem: (data.service === 'Hospedagem'),\n    startDate,\n    endDate,\n    calSummary: 'Reservado - ' + (data.name || 'Cliente') + ' (' + codigo + ')',\n    calDescription: 'Reserva recibida por ' + (data.canal || 'formulario_web') + '.\\nCódigo: ' + codigo +\n      '\\nNombre: ' + (data.name || '') +\n      '\\nTeléfono: ' + (data.phone || '') +\n      '\\nPersonas: ' + (data.people || '') +\n      '\\nServicio: ' + (data.service || '') +\n      (data.message ? ('\\nMensaje: ' + data.message) : '')\n  }\n}];"
      },
